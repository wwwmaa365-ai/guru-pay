# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used by the Express API to sign auth tokens.
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# API_SIGNING_SECRET: Optional HMAC key for verifying mobile client request signatures.
API_SIGNING_SECRET="REPLACE_WITH_API_SIGNING_SECRET"

# EXPO_PUBLIC_API_URL: Base URL used by the Expo React Native mobile app.
EXPO_PUBLIC_API_URL="http://localhost:3000"
